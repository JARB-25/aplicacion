<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="10"
      xmlns="http://javafx.com/javafx/11"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="rb.lms.HistorialController"
      prefWidth="540" prefHeight="520"
      style="-fx-background-color: #f5f5f5;">

    <padding>
        <Insets top="20" right="40" bottom="20" left="40"/>
    </padding>

    <Label fx:id="tituloLabel" text="🕐 Historial de actividad"
           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
    <Label text="Tus últimas acciones en el sistema"
           style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;"/>
    <Separator/>

    <TextArea fx:id="historialArea" prefHeight="360" maxWidth="Infinity"
              wrapText="true" editable="false"
              style="-fx-font-family: monospace; -fx-font-size: 11px;"/>

    <Label fx:id="mensajeLabel" wrapText="true" maxWidth="Infinity"
           style="-fx-font-size: 11px; -fx-font-weight: bold;"/>

    <Separator/>
    <Button text="◀  Volver al menú" onAction="#volver" prefWidth="160"
            style="-fx-pref-height:32px;"/>

</VBox>