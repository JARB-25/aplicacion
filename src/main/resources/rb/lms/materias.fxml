<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="10"
      xmlns="http://javafx.com/javafx/11"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="rb.lms.MateriasController"
      prefWidth="500" prefHeight="600"
      style="-fx-background-color: #f5f5f5;">

    <padding>
        <Insets top="20" right="40" bottom="20" left="40"/>
    </padding>

    <Label text="Gestion de Materias"
           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
    <Label fx:id="subtituloLabel" text=""
           style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;"/>
    <Separator/>

    <Label text="Mis materias:" style="-fx-font-weight: bold; -fx-font-size: 12px;"/>
    <ListView fx:id="listaMaterias" prefHeight="200" maxWidth="Infinity"/>

    <Label fx:id="materiaSelLabel" text="(ninguna seleccionada)"
           style="-fx-font-size: 11px; -fx-text-fill: #2980b9;"/>

    <Separator/>

    <Label fx:id="formLabel" text="Nueva materia:"
           style="-fx-font-weight: bold; -fx-font-size: 12px;"/>
    <TextField fx:id="nombreField" promptText="Nombre de la materia"
               maxWidth="Infinity" style="-fx-pref-height:32px;"/>

    <HBox spacing="8" alignment="CENTER">
        <Button fx:id="btnCrear" text="Crear" onAction="#crearMateria"
                prefWidth="110"
                style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-pref-height:32px;"/>
        <Button fx:id="btnRenombrar" text="Renombrar" onAction="#renombrarMateria"
                prefWidth="120"
                style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-pref-height:32px;"/>
        <Button fx:id="btnEliminar" text="Eliminar" onAction="#eliminarMateria"
                prefWidth="110"
                style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-pref-height:32px;"/>
    </HBox>

    <Separator/>
    <HBox spacing="8" alignment="CENTER">
        <Button fx:id="btnSeleccionar" text="Usar esta materia" onAction="#seleccionarMateria"
                prefWidth="180"
                style="-fx-background-color: #8e44ad; -fx-text-fill: white; -fx-pref-height:32px;"/>
        <Button fx:id="btnInscribirse" text="Inscribirme" onAction="#inscribirse"
                prefWidth="150"
                style="-fx-background-color: #16a085; -fx-text-fill: white; -fx-pref-height:32px;"/>
    </HBox>

    <Label fx:id="mensajeLabel" wrapText="true" maxWidth="Infinity"
           style="-fx-font-size: 12px; -fx-font-weight: bold;"/>

    <Separator/>
    <Button text="Volver al menu" onAction="#volver"
            prefWidth="160" style="-fx-pref-height:32px;"/>

</VBox>
