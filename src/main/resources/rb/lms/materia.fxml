<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="10"
      xmlns="http://javafx.com/javafx/11"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="rb.lms.EisenhowerController"
      prefWidth="540" prefHeight="580"
      style="-fx-background-color: #f5f5f5;">

    <padding>
        <Insets top="16" right="24" bottom="16" left="24"/>
    </padding>

    <Label text="🧠 Matriz de Eisenhower" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
    <Label text="Selecciona una tarea y muévela al cuadrante correcto" style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;"/>
    <Separator/>

    <!-- Matriz 2x2 -->
    <GridPane hgap="8" vgap="8" maxWidth="Infinity">
        <columnConstraints>
            <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
            <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
        </columnConstraints>
        <rowConstraints>
            <RowConstraints vgrow="ALWAYS" prefHeight="140"/>
            <RowConstraints vgrow="ALWAYS" prefHeight="140"/>
        </rowConstraints>

        <!-- Q1: Urgente + Importante -->
        <VBox GridPane.columnIndex="0" GridPane.rowIndex="0" spacing="4"
              style="-fx-background-color: #e74c3c; -fx-background-radius: 6; -fx-padding: 8;">
            <Label text="🔴 Q1 · Hacer ya" style="-fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label text="Urgente + Importante" style="-fx-font-size: 10px; -fx-text-fill: #ffeaea;"/>
            <ListView fx:id="listQ1" prefHeight="80" style="-fx-font-size: 11px;"/>
        </VBox>

        <!-- Q2: No urgente + Importante -->
        <VBox GridPane.columnIndex="1" GridPane.rowIndex="0" spacing="4"
              style="-fx-background-color: #2980b9; -fx-background-radius: 6; -fx-padding: 8;">
            <Label text="🔵 Q2 · Planificar" style="-fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label text="No urgente + Importante" style="-fx-font-size: 10px; -fx-text-fill: #d6eaf8;"/>
            <ListView fx:id="listQ2" prefHeight="80" style="-fx-font-size: 11px;"/>
        </VBox>

        <!-- Q3: Urgente + No importante -->
        <VBox GridPane.columnIndex="0" GridPane.rowIndex="1" spacing="4"
              style="-fx-background-color: #e67e22; -fx-background-radius: 6; -fx-padding: 8;">
            <Label text="🟠 Q3 · Delegar" style="-fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label text="Urgente + No importante" style="-fx-font-size: 10px; -fx-text-fill: #fdebd0;"/>
            <ListView fx:id="listQ3" prefHeight="80" style="-fx-font-size: 11px;"/>
        </VBox>

        <!-- Q4: No urgente + No importante -->
        <VBox GridPane.columnIndex="1" GridPane.rowIndex="1" spacing="4"
              style="-fx-background-color: #7f8c8d; -fx-background-radius: 6; -fx-padding: 8;">
            <Label text="⚫ Q4 · Eliminar" style="-fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label text="No urgente + No importante" style="-fx-font-size: 10px; -fx-text-fill: #ecf0f1;"/>
            <ListView fx:id="listQ4" prefHeight="80" style="-fx-font-size: 11px;"/>
        </VBox>
    </GridPane>

    <!-- Controles de reclasificación (solo PROFESOR) -->
    <Separator/>
    <Label text="Reclasificar tarea (escribe el título y elige cuadrante):" style="-fx-font-size: 11px;"/>
    <HBox spacing="6" alignment="CENTER">
        <Button fx:id="btnMoverQ1" text="→ Q1" onAction="#moverQ1"
                style="-fx-background-color: #e74c3c; -fx-text-fill: white;" prefWidth="72"/>
        <Button fx:id="btnMoverQ2" text="→ Q2" onAction="#moverQ2"
                style="-fx-background-color: #2980b9; -fx-text-fill: white;" prefWidth="72"/>
        <Button fx:id="btnMoverQ3" text="→ Q3" onAction="#moverQ3"
                style="-fx-background-color: #e67e22; -fx-text-fill: white;" prefWidth="72"/>
        <Button fx:id="btnMoverQ4" text="→ Q4" onAction="#moverQ4"
                style="-fx-background-color: #7f8c8d; -fx-text-fill: white;" prefWidth="72"/>
    </HBox>
    <Label fx:id="mensajeLabel" style="-fx-font-size: 11px;" wrapText="true" maxWidth="Infinity"/>
    <Label fx:id="tituloSelLabel" text="(ninguna tarea seleccionada)" style="-fx-font-size: 11px; -fx-text-fill: #666;"/>

    <Separator/>
    <Button text="◀  Volver al menú" onAction="#volver" prefWidth="160" style="-fx-pref-height:32px;"/>

</VBox>