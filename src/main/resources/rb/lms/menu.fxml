<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10" alignment="CENTER"
      xmlns="http://javafx.com/javafx/11"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="rb.lms.MenuController"
      prefWidth="460" prefHeight="600"
      style="-fx-background-color: #f5f5f5;">

    <padding>
        <Insets top="30" right="70" bottom="30" left="70"/>
    </padding>

    <Label text="🎓 LMS Poligran"
           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
    <Label fx:id="welcomeLabel" text="Bienvenido"
           style="-fx-font-size: 13px; -fx-text-fill: #34495e;"/>
    <Label fx:id="rolLabel" text=""
           style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;
                  -fx-background-color: #ecf0f1; -fx-padding: 2 8 2 8; -fx-background-radius: 8;"/>
    <Label fx:id="materiaLabel" text=""
           style="-fx-font-size: 11px; -fx-text-fill: #2980b9; -fx-font-weight: bold;
                  -fx-background-color: #d6eaf8; -fx-padding: 2 8 2 8; -fx-background-radius: 8;"
           wrapText="true" maxWidth="Infinity"/>

    <Separator/>

    <!-- GESTIÓN DE MATERIAS (siempre visible) -->
    <Button fx:id="btnGestionMaterias" text="📚  Gestionar materias"
            onAction="#irAGestionMaterias"
            maxWidth="Infinity" style="-fx-pref-height:36px;"/>

    <Separator/>

    <!-- ESTUDIANTE -->
    <Button fx:id="btnVerTareas" text="📋  Ver tareas pendientes"
            onAction="#irAVerTareas"
            maxWidth="Infinity" style="-fx-pref-height:36px;"/>
    <Button fx:id="btnEntregar"  text="📤  Entregar tarea"
            onAction="#irAEntregar"
            maxWidth="Infinity" style="-fx-pref-height:36px;"/>
    <Button fx:id="btnNotas"     text="📊  Ver mis notas"
            onAction="#irANotas"
            maxWidth="Infinity" style="-fx-pref-height:36px;"/>

    <!-- PROFESOR -->
    <Button fx:id="btnCrearTarea" text="➕  Crear tarea"
            onAction="#irACrearTarea"
            maxWidth="Infinity" style="-fx-pref-height:36px;"/>
    <Button fx:id="btnCalificar"  text="✏️   Calificar entregas"
            onAction="#irACalificar"
            maxWidth="Infinity" style="-fx-pref-height:36px;"/>

    <!-- AMBOS (requiere materia seleccionada) -->
    <Button fx:id="btnEisenhower" text="🧠  Matriz de prioridad"
            onAction="#irAEisenhower"
            maxWidth="Infinity" style="-fx-pref-height:36px;"/>
    <Button fx:id="btnHistorial"  text="🕐  Historial de actividad"
            onAction="#irAHistorial"
            maxWidth="Infinity" style="-fx-pref-height:36px;"/>

    <Separator/>

    <Button text="🚪  Cerrar sesión" onAction="#cerrarSesion" prefWidth="160"
            style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-pref-height:34px;"/>

</VBox>